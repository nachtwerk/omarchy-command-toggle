#!/bin/bash
# usage: toggle-run <unit> <description> <restart: yes|no> <command>
# Starts <command> as a transient systemd user unit. Clears a previous failed
# state first so the same unit name can be reused.
#
# <command> is run through `bash -lc`, so it is a shell program by design: it
# comes from the popup or from `commands` in shell.json, both of which are the
# user typing a command for themselves. Nothing that arrives over the widget's
# IPC target reaches this script - see the note above IpcHandler in Panel.qml.
set -u
unit="$1"
desc="$2"
restart="$3"
cmd="$4"

systemctl --user reset-failed "$unit" 2>/dev/null || true

args=(--user --quiet --unit="$unit" --description="$desc" -p KillMode=mixed)
if [[ $restart == yes ]]; then
  args+=(-p Restart=on-failure -p RestartSec=3)
fi

exec systemd-run "${args[@]}" -- bash -lc "$cmd"
